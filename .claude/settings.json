{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.local.ps1)",
      "Read(**/samconfig.toml)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(sam deploy *)",
      "Bash(sam delete *)",
      "Bash(aws *)",
      "Bash(gh pr merge *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(npm install *)",
      "Bash(npx expo install *)",
      "Bash(gh pr create *)"
    ],
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run typecheck)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff --stat main...HEAD)",
      "Bash(git diff main...HEAD)",
      "Bash(git log --oneline -20)"
    ]
  }
}