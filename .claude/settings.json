{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.local.ps1)",
      "Read(**/samconfig.toml)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(sam deploy *)",
      "Bash(sam delete *)",
      "Bash(aws *)",
      "Bash(gh pr merge *)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.local.ps1)",
      "Edit(**/samconfig.toml)",
      "Write(**/.env)",
      "Write(**/.env.*)",
      "Write(**/*.local.ps1)",
      "Write(**/samconfig.toml)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(npm install *)",
      "Bash(npx expo install *)",
      "Bash(gh pr create *)"
    ],
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run typecheck)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git diff --stat main...HEAD)",
      "Bash(git diff main...HEAD)",
      "Bash(git log --oneline -20)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git diff --stat *)",
      "Bash(node --test .claude/hooks/guardia-rol.test.mjs)"
    ]
  }
}
