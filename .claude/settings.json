{
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.local.ps1)",
      "Read(**/samconfig.toml)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(sam deploy *)",
      "Bash(sam delete *)",
      "Bash(aws *)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git commit *)",
      "Bash(npm install *)",
      "Bash(npx expo install *)"
    ],
    "allow": [
      "Bash(npm test *)",
      "Bash(npm run typecheck)"
    ]
  }
}